{
  "expo": {
    "name": "Zuli",
    "slug": "zuli",
    "scheme": "zuli",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/zuli_512.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/zuli_512.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      "expo-font",
      "expo-sqlite",
      "expo-asset"
    ]
  }
}
